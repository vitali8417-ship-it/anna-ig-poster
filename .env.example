# ===== Instagram Graph API (Meta) =====
# Long-Lived Page Access Token (siehe README.md fuer Setup)
IG_ACCESS_TOKEN=EAAB...
# Instagram Business Account ID (numerisch)
IG_BUSINESS_ACCOUNT_ID=178414...

# ===== Image Hosting (Imgur, kostenlos) =====
# https://api.imgur.com/oauth2/addclient -> "OAuth 2 authorization without callback URL"
IMGUR_CLIENT_ID=

# ===== HTTP-API Schutz =====
# Beliebiges Geheimnis. Anna muss diesen Wert im Header
#   X-API-Key: <wert>
# mitschicken, wenn sie ueber die HTTP-API postet.
API_KEY=

# ===== Verhalten =====
# true = nur Logs, keine echten Posts (zum Testen)
DRY_RUN=true

# ===== Optional: KI-Content-Generator =====
# Nur noetig, wenn Anna die optionale generate.py-CLI nutzen will.
OPENAI_API_KEY=
